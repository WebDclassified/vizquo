  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:firefox:mv3": "wxt build -b firefox --mv3",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
