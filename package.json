    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "release": "node scripts/release-store.mjs",
    "promo": "node scripts/generate-promo-tile.mjs",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "screenshots:cws": "node scripts/resize-screenshots.mjs",
    "check:landing": "node scripts/check-landing-browsers.mjs"
  },
  "dependencies": {
    "@kobalte/core": "^0.13.12",
    "@webext-core/messaging": "^4.0.0",
    "comlink": "^4.4.2",
    "css-tree": "^3.2.1",
    "culori": "^4.0.2",
    "dexie": "^4.4.4",
    "fflate": "^0.8.3",
    "lucide-solid": "^1.30.0",
    "solid-js": "^1.9.14",
    "unocss": "^66.7.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@playwright/test": "^1.62.1",
    "@types/chrome": "^0.2.5",
    "@unocss/reset": "^66.7.5",
    "@wxt-dev/module-solid": "^1.1.4",
    "fake-indexeddb": "^6.2.5",
